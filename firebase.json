{
  "hosting": {
    "public": "dist/client",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/archives/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "regex": "^/archive/?$",
        "destination": "/blogs",
        "type": 301
      },
      {
        "regex": "^/home/?$",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "regex": "^/((?:[0-9c-lp-qs-vx-z][a-z0-9]*|w(?:[0-9a-nq-z][a-z0-9]*|p[a-z0-9]+|o(?:[0-9a-qs-z][a-z0-9]*|r(?:[0-9a-ce-z][a-z0-9]*|d(?:[0-9a-oq-z][a-z0-9]*|p(?:[0-9a-qs-z][a-z0-9]*|r(?:[0-9a-df-z][a-z0-9]*|e(?:[0-9a-rt-z][a-z0-9]*|s(?:[0-9a-rt-z][a-z0-9]*|s[a-z0-9]+)?)?)?)?)?)?)?)?|a(?:[0-9a-ce-z][a-z0-9]*|d(?:[0-9a-ln-z][a-z0-9]*|m(?:[0-9a-hj-z][a-z0-9]*|i(?:[0-9a-mo-z][a-z0-9]*|n(?:[0-9a-hj-z][a-z0-9]*|i(?:[0-9a-rt-z][a-z0-9]*|s(?:[0-9a-su-z][a-z0-9]*|t(?:[0-9a-qs-z][a-z0-9]*|r(?:[0-9b-z][a-z0-9]*|a(?:[0-9a-su-z][a-z0-9]*|t(?:[0-9a-np-z][a-z0-9]*|o(?:[0-9a-qs-z][a-z0-9]*|r[a-z0-9]+)?)?)?)?)?)?)?)?)?)?)?)?|b(?:[0-9bd-jl-z][a-z0-9]*|a(?:[0-9a-bd-z][a-z0-9]*|c(?:[0-9a-jl-z][a-z0-9]*|k(?:[0-9a-tv-z][a-z0-9]*|u(?:[0-9a-oq-z][a-z0-9]*|p[a-z0-9]+)?)?)?)?|c[a-z0-9]+|k[a-z0-9]+)?|m(?:[0-9b-z][a-z0-9]*|a(?:[0-9a-hj-z][a-z0-9]*|i(?:[0-9a-mo-z][a-z0-9]*|n[a-z0-9]+)?)?)?|n(?:[0-9a-df-z][a-z0-9]*|e(?:[0-9a-vx-z][a-z0-9]*|w[a-z0-9]+)?)?|o(?:[0-9a-km-z][a-z0-9]*|l(?:[0-9a-ce-z][a-z0-9]*|d[a-z0-9]+)?)?|r(?:[0-9a-np-z][a-z0-9]*|o(?:[0-9a-tv-z][a-z0-9]*|u(?:[0-9a-mo-z][a-z0-9]*|n(?:[0-9a-ce-z][a-z0-9]*|d(?:[0-9a-bd-z][a-z0-9]*|c(?:[0-9a-tv-z][a-z0-9]*|u(?:[0-9ac-z][a-z0-9]*|b(?:[0-9a-df-z][a-z0-9]*|e[a-z0-9]+)?)?)?)?)?)?)?)?)|(?:[a-vx-z0-9][a-z0-9]*|w(?:[a-oq-z0-9][a-z0-9]*)?|wp[a-z0-9]+)(?:-[a-z0-9]+)+|(?:books|projects|entertainment|gogs)/[a-z0-9-]+|podcasts/(?:created|listening)(?:/[a-z0-9-]+)?|people-and-journal/(?:journal|people)(?:/[a-z0-9-]+)?|admin/(?:api|invitations)|api/(?:cms|v1|reading|search)(?:/[A-Za-z0-9_-]+)*(?:\\.(?:webp|mp4|webm|mp3|m4a|ogg))?|media/[a-f0-9]{64}/(?:master\\.webp|400\\.webp|800\\.webp|1600\\.webp|source\\.(?:mp4|webm|mp3|m4a|ogg))|api/openapi\\.json|sitemap\\.xml|rss\\.xml|_image)?/?$",
        "run": {
          "serviceId": "harithsa-journal",
          "region": "us-east1",
          "pinTag": true
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/{images,brand}/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      }
    ]
  }
}
