---
import "../styles/site.css";
import "../styles/journal.css";
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "@fontsource-variable/public-sans";
import "@fontsource-variable/jetbrains-mono";
import EditorialImage from "../components/EditorialImage.astro";
import Wordmark from "../components/Wordmark.astro";
import { site } from "../data/site";
import { navigation } from "../data/navigation";
import { canonicalPath, pageMeta } from "../lib/page-meta";
interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  publishedDate?: string;
  modifiedDate?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description: providedDescription,
  image = "/brand/v1/social-card.png",
  imageAlt,
  article = false,
  publishedDate,
  modifiedDate,
  structuredData,
} = Astro.props;
const palette = pageMeta(Astro.url.pathname, article);
const description = providedDescription ?? palette.description;
const pageTitle = title
  ? `${title} | ${site.title}`
  : `${site.title} — A curious mind. An open notebook.`;
const canonical = new URL(canonicalPath(Astro.url.pathname), site.url);
const current = Astro.url.pathname;
const noindex =
  current === "/404" ||
  current === "/404.html" ||
  current.startsWith("/admin") ||
  current.startsWith("/people-and-journal") ||
  current.startsWith("/account") ||
  Boolean(Astro.locals.draftPreview);
const author = {
  "@type": "Person",
  "@id": `${site.url}/meet-vish#person`,
  name: site.author,
  url: `${site.url}/meet-vish`,
  sameAs: [site.github, site.linkedin],
};
const graph = [
  {
    ...author,
    jobTitle: "Senior Customer Success Engineer",
    homeLocation: { "@type": "Place", name: "Bengaluru, India" },
  },
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.title,
    publisher: { "@id": author["@id"] },
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical.href,
    name: pageTitle,
    description,
    isPartOf: { "@id": `${site.url}/#website` },
  },
  ...(article && publishedDate
    ? [
        {
          "@type": "BlogPosting",
          headline: title,
          description,
          image: [new URL(image, site.url).href],
          datePublished: publishedDate,
          dateModified: modifiedDate ?? publishedDate,
          author: { "@id": author["@id"] },
          publisher: { "@id": author["@id"] },
          mainEntityOfPage: { "@id": `${canonical}#webpage` },
        },
      ]
    : []),
  ...(structuredData ? [structuredData] : []),
];
---

<!doctype html>
<html
  lang="en"
  style={`--page-chrome-light: ${palette.light}; --page-chrome-dark: ${palette.dark}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content={palette.light}
      data-light={palette.light}
      data-dark={palette.dark}
    />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("harithsa.theme.v1");
        } catch {}
        if (theme !== "light" && theme !== "dark")
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        const chrome = document.querySelector('meta[name="theme-color"]');
        if (chrome)
          chrome.setAttribute("content", chrome.getAttribute(`data-${theme}`));
      })();
    </script>
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand/v1/favicon.svg" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48"
    />
    <link
      rel="icon"
      type="image/png"
      href="/brand/v1/favicon-32.png"
      sizes="32x32"
    />
    <link
      rel="apple-touch-icon"
      href="/brand/v1/apple-touch-icon.png"
      sizes="180x180"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="The Harithsa Notes" />
    <meta name="apple-mobile-web-app-title" content="Harithsa Notes" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url)} />
    {(imageAlt || image === "/brand/v1/social-card.png") && (
      <meta
        property="og:image:alt"
        content={
          imageAlt ?? "The Harithsa Notes editorial wordmark with bookmark h"
        }
      />
    )}
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_IN" />
    {publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    {modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.url)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": graph,
      }).replace(/</g, "\u003c")}
    />
    <script src="../scripts/telemetry.ts"></script>
    <script src="../scripts/theme.ts"></script>
  </head>
  <body>
    {Astro.locals.draftPreview && (
      <aside class="draft-preview-banner" role="status">
        Private draft preview · this version is not public.{" "}
        <a href="/admin">Back to the workspace</a>
      </aside>
    )}
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <Wordmark homeLabel />
      <nav aria-label="Main navigation" class="desktop-nav">
        <a href="/" aria-current={current === "/" ? "page" : undefined}>
          Home
        </a>
        {navigation.map((item, index) => (
          <div
            class="nav-section"
            data-nav-section
            style={`--menu-tone: var(--${item.tone})`}
          >
            <div class="nav-label">
              <button
                class="nav-disclosure"
                aria-label={`Explore ${item.label}`}
                aria-expanded="false"
                aria-controls={`section-menu-${index}`}
                aria-current={current === item.href ? "page" : undefined}
              >
                {item.label}
              </button>
            </div>
            <div class="mega-menu" id={`section-menu-${index}`} hidden>
              <div class="mega-intro">
                <span class="eyebrow">{item.label}</span>
                <h2>{item.title}</h2>
                <p>{item.description}</p>
              </div>
              <nav aria-label={`${item.label} sections`} class="mega-links">
                {item.links.map((link) => (
                  <a href={link.href}>{link.label.replace(/\s*↗/g, "")}</a>
                ))}
              </nav>
              <EditorialImage
                src={item.image}
                alt=""
                widths={[400, 600, 900]}
                sizes="33vw"
                class="menu-illustration"
              />
            </div>
          </div>
        ))}
      </nav>
      <div class="header-actions">
        <a
          class="reading-entry-link"
          href="/people-and-journal"
          rel="nofollow"
          aria-label="Sign in to the private reading room"
        >
          Sign in
        </a>
        <button
          class="theme-toggle"
          data-theme-toggle
          aria-label="Switch to dark mode"
          aria-pressed="false"
          title="Change colour mode"
          hidden
        >
          <span class="theme-orbit" aria-hidden="true">
            <span class="theme-sun"></span>
            <span class="theme-moon"></span>
            <span class="theme-star theme-star-one"></span>
            <span class="theme-star theme-star-two"></span>
          </span>
        </button>
        <a
          class="search-link"
          href="/blogs#search"
          aria-label="Search articles"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 5 5" />
          </svg>
        </a>
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open navigation"
        >
          Menu
        </button>
      </div>
      <nav id="mobile-menu" aria-label="Mobile navigation" hidden>
        <a href="/">Home</a>
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main id="main">
      <script>
        import "../scripts/reading-link";
      </script>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <Wordmark />
        <p>
          A few things I’m learning.
          <br />A little of the life in between.
        </p>
        <div class="footer-social">
          <a href={site.github}>GitHub ↗</a>
          <a href={site.linkedin}>LinkedIn ↗</a>
          <a href="/rss.xml">RSS ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Vishruth Harithsa</span>
        <span>
          Made with curiosity in Bengaluru, India{" "}
          <span class="little-spark">✳</span>
        </span>
        <div>
          <a href="/privacy">Privacy</a>
          <a href="/admin" rel="nofollow">
            Workspace
          </a>
          <button class="text-button" data-privacy-settings>
            Cookie settings
          </button>
        </div>
      </div>
    </footer>
    <aside class="consent-banner" aria-label="Analytics preferences" hidden>
      <div>
        <strong>A little note on cookies</strong>
        <p>
          With your permission, I use Google Analytics and Dynatrace to
          understand what’s useful and keep this site working well.{" "}
          <a href="/privacy">Privacy details</a>
        </p>
      </div>
      <div class="consent-actions">
        <button class="button button-outline" data-consent="denied">
          Only essential
        </button>
        <button class="button" data-consent="granted">
          Allow analytics
        </button>
      </div>
    </aside>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
