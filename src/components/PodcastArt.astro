---
import type { ListeningNote } from "../data/interests";
import { responsiveMedia } from "../lib/post-media";
interface Props {
  note: ListeningNote;
  index?: number;
}
const { note, index = 0 } = Astro.props;
const tones = ["peach", "lilac", "blue", "ochre", "peach"];
---

{note.image ? (
  <img
    class="record-art podcast-record-art"
    {...responsiveMedia(
      note.image,
      "auto, (max-width: 640px) 92vw, (max-width: 1000px) 48vw, 500px",
    )}
    alt={note.artLabel}
    width="1200"
    height="1000"
    loading="lazy"
  />
) : (
  <div
    class={`record-art podcast-record-art tone-${tones[index % tones.length]}`}
    aria-hidden="true"
  >
    <div class="record">
      <span>{note.artLabel}</span>
    </div>
    <span class="record-edition">
      {note.kind === "created" ? "CREATED" : "LISTENING"} /{" "}
      {String(index + 1).padStart(2, "0")}
    </span>
  </div>
)}
