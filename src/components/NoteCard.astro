---
import ArticleArt from "./ArticleArt.astro";
import { formatDate, type Article } from "../lib/content";
interface Props {
  article: Article;
  index?: number;
}
const { article } = Astro.props;
---

<article
  class:list={[
    "note-card",
    { "technical-card": article.topic !== "Life & learning" },
  ]}
  data-note
  data-topic={article.topic}
  data-search={`${article.title} ${article.description} ${article.topic}`.toLowerCase()}
>
  <a
    href={`/${article.slug}`}
    class="card-image-link"
    tabindex="-1"
    aria-hidden="true"
  >
    <ArticleArt article={article} decorative />
  </a>
  <div class="card-copy">
    <span class="eyebrow">{article.topic}</span>
    <h3>
      <a href={`/${article.slug}`}>{article.title}</a>
    </h3>
    <p>{article.description}</p>
    <div class="note-meta">
      <time datetime={article.date}>{formatDate(article.date)}</time>
      <span>·</span>
      <span>{article.minutes} min read</span>
    </div>
  </div>
</article>
