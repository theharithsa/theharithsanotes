---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Project } from "../data/projects";
import { responsiveMedia } from "../lib/post-media";
import { firebaseImage } from "../lib/firebase-art.mjs";
interface Props {
  project: Project;
  detail?: boolean;
}
const { project, detail = false } = Astro.props;
const covers = import.meta.glob<{ default: ImageMetadata }>(
  "../../public/images/projects/*-editorial-v2.png",
  { eager: true },
);
const cover = covers[`../../public${project.image}`]?.default;
const widths = [400, 600, 900, 1200];
const hosted =
  cover && process.env.CMS_BUILD_TARGET === "firebase"
    ? firebaseImage(cover, widths)
    : undefined;
const sizes = detail
  ? "(max-width: 760px) 92vw, 60vw"
  : "(max-width: 600px) 92vw, (max-width: 1000px) 48vw, 67vw";
---

{hosted ? (
  <img
    {...hosted}
    class="project-concept"
    alt={project.imageAlt}
    sizes={sizes}
    loading={detail ? "eager" : "lazy"}
    fetchpriority={detail ? "high" : "auto"}
    decoding="async"
  />
) : cover ? (
  <Image
    class="project-concept"
    src={cover}
    alt={project.imageAlt}
    width={1200}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={82}
    loading={detail ? "eager" : "lazy"}
    fetchpriority={detail ? "high" : "auto"}
  />
) : (
  <img
    class="project-concept"
    {...responsiveMedia(
      project.image,
      detail
        ? "(max-width: 760px) 92vw, (max-width: 1280px) 60vw, 768px"
        : "(max-width: 760px) 92vw, 540px",
    )}
    alt={project.imageAlt}
    width="1600"
    height="1067"
    loading={detail ? "eager" : "lazy"}
    decoding="async"
  />
)}
