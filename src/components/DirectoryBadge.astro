---
import lightBadge from "../../assets/smm/wedirectory/we_logo1_black.svg?url";
import darkBadge from "../../assets/smm/wedirectory/we_logo1_white.svg?url";
---

<a
  class="directory-badge"
  href="https://we.directory/theharithsa"
  rel="me"
  aria-label="Find Vishruth Harithsa on WeDirectory"
>
  <img
    class="directory-badge-light"
    src={lightBadge}
    width="609"
    height="185"
    alt="WeDirectory"
    loading="lazy"
  />
  <img
    class="directory-badge-dark"
    src={darkBadge}
    width="609"
    height="185"
    alt="WeDirectory"
    loading="lazy"
  />
</a>
