---
import type { ProjectScreenshot } from "../data/projects";
import { responsiveMedia } from "../lib/post-media";

interface Props {
  screenshot: ProjectScreenshot;
}

const { screenshot } = Astro.props;
const previewWidth = Math.min(
  600,
  screenshot.width,
  Math.max(1, Math.floor((480 * screenshot.width) / screenshot.height)),
);
const sizes = `(max-width: ${previewWidth + 40}px) calc(100vw - 40px), ${previewWidth}px`;
---

<figure class="project-screenshot" style={`max-inline-size: ${previewWidth}px`}>
  <a href={screenshot.image} title="Open full-size screenshot">
    <img
      {...responsiveMedia(screenshot.image, sizes)}
      alt={screenshot.imageAlt}
      width={screenshot.width}
      height={screenshot.height}
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>{screenshot.caption}</figcaption>
</figure>

<style>
  .project-screenshot {
    margin-inline: 0;
  }
</style>
