---
import logo from "../../public/brand/v1/logo-horizontal-ink.svg?raw";
interface Props {
  homeLabel?: boolean;
}
const { homeLabel = false } = Astro.props;
const artwork = logo
  .replace('color="#242321"', "")
  .replace(
    'role="img" aria-label="The Harithsa Notes"',
    'aria-hidden="true" focusable="false"',
  );
---

<a
  class="wordmark"
  href="/"
  aria-label={homeLabel ? "The Harithsa Notes home" : "The Harithsa Notes"}
>
  <span class="wordmark-art" set:html={artwork} />
</a>
