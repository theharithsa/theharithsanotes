---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const {
  src,
  alt,
  eager = false,
  widths = [400, 800, 1200],
  sizes = "(max-width: 640px) 92vw, (max-width: 1000px) 48vw, 800px",
  class: className,
} = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>(
  ["../../public/images/blog/*.png", "../../public/images/navigation/*.png"],
  { eager: true },
);
const asset = assets[`../../public${src}`]?.default;
if (!asset) throw new Error(`Missing editorial asset: ${src}`);
---

<Image
  src={asset}
  alt={alt}
  width={Math.max(...widths)}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={80}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  class={className}
/>
