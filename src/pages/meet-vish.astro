---
import DirectoryBadge from "../components/DirectoryBadge.astro";
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { getJournalPage } from "../lib/journal";
import { cleanHtml } from "../server/models";
import { responsiveMedia } from "../lib/post-media";
const page = await getJournalPage("meet-vish");
---

<Base title="Meet Vish">
  <section class="meet-hero tone-peach">
    <div class="wrap">
      <div>
        <span class="eyebrow">HELLO, I’M VISHRUTH HARITHSA</span>
        {page.heading === "Call me Vish." ? (
          <h1>
            Call me
            <br />
            <em>Vish.</em>
          </h1>
        ) : (
          <h1>{page.heading ?? page.title}</h1>
        )}
        <p>{page.description}</p>
        <span class="location">BASED IN BENGALURU, INDIA</span>
        <div class="meet-directory">
          <DirectoryBadge />
        </div>
      </div>
      <img
        {...responsiveMedia(
          page.image ?? "/images/vish-casual-illustration.webp",
          "(max-width: 760px) 92vw, (max-width: 1200px) 43vw, 540px",
        )}
        alt={
          page.imageAlt ??
          "Illustration of Vishruth smiling in a sage-green T-shirt and jeans"
        }
        width="1200"
        height="1800"
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="wrap personal-statement space">
    <span class="eyebrow">A LITTLE CONTEXT</span>
    <h2>
      A life shaped by curiosity.
      <br />
      <span>And the people I’ve met along the way.</span>
    </h2>
    <div class="personal-story post-body">
      {page.html?.trim() ? (
        <Fragment set:html={cleanHtml(page.html)} />
      ) : (
        page.paragraphs.map((paragraph) => <p>{paragraph}</p>)
      )}
    </div>
    <div class="meet-signoff">
      <img
        src="/images/vish-signature.webp"
        alt="Vishruth Harithsa’s handwritten signature"
        width="1200"
        height="478"
        loading="lazy"
        decoding="async"
      />
      <p class="meet-signoff-name">Vishruth Harithsa</p>
    </div>
  </section>
  <section
    class="interest-links wrap"
    aria-label="Explore more of the notebook"
  >
    <a
      href="/projects"
      style="--interest-art: url(/images/navigation/projects-portrait-v2.webp)"
    >
      <span>01 / MAKING</span>
      <h3>The workbench</h3>
      <p>Ideas turned into things people can use.</p>
      <b aria-hidden="true">↗</b>
    </a>
    <a
      href="/books"
      style="--interest-art: url(/images/navigation/books-portrait-v2.webp)"
    >
      <span>02 / LEARNING</span>
      <h3>The bookshelf</h3>
      <p>Different authors. Different ways to see.</p>
      <b aria-hidden="true">↗</b>
    </a>
    <a
      href="/entertainment"
      style="--interest-art: url(/images/navigation/entertainment-portrait-v2.webp)"
    >
      <span>03 / UNWINDING</span>
      <h3>Beyond work</h3>
      <p>Good stories and what they leave behind.</p>
      <b aria-hidden="true">↗</b>
    </a>
  </section>
  <section class="connection-band tone-sage">
    <div class="wrap">
      <h2>
        Good things often start
        <br />
        with a conversation.
      </h2>
      <div>
        <a href={site.mentoring} class="text-link">
          Let’s connect on Topmate ↗
        </a>
        <a href={site.linkedin} class="text-link">
          Find me on LinkedIn ↗
        </a>
        <a
          href="https://community.dynatrace.com/t5/Community-news/Video-interview-with-the-Member-of-the-Month-Vishruth-Harithsa/ba-p/186472"
          class="text-link"
        >
          My Dynatrace Community interview ↗
        </a>
      </div>
    </div>
  </section>
</Base>
