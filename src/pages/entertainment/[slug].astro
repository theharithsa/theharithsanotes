---
import Base from "../../layouts/Base.astro";
import ScreenPoster from "../../components/ScreenPoster.astro";
import {
  screenNotes as snapshotNotes,
  type ScreenNote,
} from "../../data/screen-notes";
import { detail, getScreenNotes } from "../../lib/journal";
import { formatDate } from "../../lib/content";
export function getStaticPaths() {
  return snapshotNotes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}
interface Props {
  note: ScreenNote;
}
const loaded = Astro.props.note
  ? { data: Astro.props.note, canonical: Astro.props.note.slug }
  : await detail<ScreenNote>(
      "entertainment",
      Astro.params.slug ?? "",
      snapshotNotes,
    );
if (!loaded) return Astro.rewrite("/404");
if (loaded.canonical !== Astro.params.slug)
  return Astro.redirect(`/entertainment/${loaded.canonical}`, 301);
const note = loaded.data;
const screenNotes = await getScreenNotes();
const next =
  screenNotes[
    (screenNotes.findIndex((item) => item.slug === note.slug) + 1) %
      screenNotes.length
  ];
---

<Base
  title={`${note.title}: ${note.headline}`}
  description={note.description}
  image={note.poster.src}
>
  <article class="screen-note-page">
    <header class="wrap screen-note-header">
      <a href="/entertainment" class="back-link">
        ← All screen notes
      </a>
      <span class="eyebrow">
        {note.kind} · {note.title}
      </span>
      <h1>{note.headline}</h1>
      <p class="article-deck">{note.description}</p>
      <p class="screen-note-date">
        By <a href="/meet-vish">Vishruth Harithsa</a> · Reflection recorded{" "}
        <time datetime={note.date}>{formatDate(note.date)}</time>
      </p>
    </header>
    <div class="wrap screen-note-visual">
      <ScreenPoster note={note} eager />
    </div>
    <div class="wrap screen-note-reading">
      <p class="screen-title-link">
        <a
          class="text-link"
          href={note.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {note.linkLabel} ↗
        </a>
      </p>
      <p class="editorial-caption">
        Edited from my personal viewing notes. Contains story details.
      </p>
      <div class="article-body">
        {note.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <aside class={`screen-takeaway tone-${note.tone}`}>
        <span class="eyebrow">WHAT I TOOK WITH ME</span>
        <p>{note.lesson}</p>
      </aside>
      {note.titleNote && (
        <p class="editorial-caption">
          {note.titleNote} <a href={note.officialUrl}>About the series ↗</a>
        </p>
      )}
      <div class="screen-note-next">
        <span class="eyebrow">ANOTHER STORY, ANOTHER PERSPECTIVE</span>
        <a href={`/entertainment/${next.slug}`}>
          <h2>{next.title} ↗</h2>
          <p>{next.description}</p>
        </a>
      </div>
    </div>
  </article>
</Base>
