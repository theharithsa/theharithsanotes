---
import Base from "../layouts/Base.astro";
---

<Base title="Search" description="Search the published notebook.">
  <section class="wrap search-entry">
    <span class="eyebrow">FOLLOW YOUR CURIOSITY</span>
    <h1>Search the notebook.</h1>
    <p>The search window opens here automatically.</p>
    <button class="button" data-open-search>
      Open search
    </button>
    <a class="text-link" href="/">
      Back to the notebook
    </a>
    <noscript>
      Search needs JavaScript. You can browse the sections using the menu.
    </noscript>
  </section>
</Base>
