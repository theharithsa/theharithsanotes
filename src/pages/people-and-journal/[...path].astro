---
import Base from "../../layouts/Base.astro";
import "../../styles/reading.css";
export function getStaticPaths() {
  return [undefined, "journal", "people"].map((path) => ({ params: { path } }));
}
const selectedCollection =
  Astro.params.path?.split("/")[0] === "people" ? "people" : "journal";
const isDetail = Boolean(Astro.params.path?.split("/")[1]);
---

<Base
  title="People and Journal"
  description="A private reading room for the people Vish invites."
>
  <section
    class:list={[
      "section-masthead tone-blue",
      { "private-detail-masthead": isDetail },
    ]}
  >
    <div class="wrap">
      <span class="eyebrow">THE PERSONAL NOTEBOOK</span>
      <h1>People &amp; Journal</h1>
      <p>Small moments. Important people. A little more of the story.</p>
    </div>
  </section>
  <section class="wrap space reading-room" id="reading-room">
    <div class="reading-toolbar" id="reading-toolbar" hidden>
      <nav class="filters reading-categories" aria-label="Choose a collection">
        <a
          href="/people-and-journal/journal"
          aria-current={selectedCollection === "journal" ? "page" : undefined}
        >
          Journal
        </a>
        <a
          href="/people-and-journal/people"
          aria-current={selectedCollection === "people" ? "page" : undefined}
        >
          People
        </a>
      </nav>
      <button id="reader-signout" class="text-button">
        Sign out
      </button>
    </div>
    <div
      class="reading-loading"
      id="reading-loading"
      role="status"
      aria-live="polite"
    >
      <span class="eyebrow">THE NOTEBOOK</span>
      <p id="reader-loading-message">Opening your notebook…</p>
      <div class="reading-placeholder" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="reading-skeleton-card">
            <span class="reading-skeleton-cover"></span>
            <div class="reading-skeleton-copy">
              <span class="reading-skeleton-line skeleton-kicker"></span>
              <span class="reading-skeleton-line skeleton-title"></span>
              <span class="reading-skeleton-line"></span>
              <span class="reading-skeleton-line skeleton-short"></span>
            </div>
          </div>
        ))}
      </div>
      <button id="reader-retry" class="reading-button" hidden>
        Try again
      </button>
    </div>
    <noscript>
      <p>Enable JavaScript to sign in and read this private notebook.</p>
    </noscript>
    <div class="reading-gate" id="reading-gate" hidden>
      <span aria-hidden="true" class="reading-seal">
        ✎
      </span>
      <h2>A seat at the table.</h2>
      <p>
        This part of the notebook is shared by invitation. Continue with the
        Google account Vish invited.
      </p>
      <button id="reader-signin" class="reading-button">
        Continue with Google
      </button>
      <p role="status" id="reader-message">
        By invitation, with a little room for curiosity.
      </p>
    </div>
    <div id="reading-content" hidden>
      <div id="reading-posts"></div>
      <article id="reading-post" class="post-page" hidden>
        <a id="reader-back" href="/people-and-journal/journal">
          Back to the notebook
        </a>
        <img id="reading-cover" alt="" />
        <div class="reading-post-heading">
          <p id="reading-date"></p>
          <h2 id="reading-title"></h2>
          <p id="reading-description"></p>
        </div>
        <div id="reading-body" class="post-body post-dropcap"></div>
      </article>
    </div>
  </section>
  <script>
    import "../../scripts/reading";
  </script>
</Base>
