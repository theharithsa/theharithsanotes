---
import Base from "../layouts/Base.astro";
import NoteCard from "../components/NoteCard.astro";
import { articles } from "../lib/content";
const lead = articles[0];
const selection = articles
  .filter((a) => a.slug !== lead.slug && !a.slug.includes("ayrton-senna"))
  .slice(0, 2);
---

<Base>
  <section class="home-hero">
    <img
      src="/images/curiosity-editorial.webp"
      alt="An illustrated notebook landscape with a telescope, a tree, circuits, and open pages"
      width="1536"
      height="1024"
      fetchpriority="high"
    />
    <div class="hero-welcome">
      <span class="eyebrow">A PERSONAL JOURNAL BY VISHRUTH HARITHSA</span>
      <h1>
        So much to
        <br />
        <em>be curious about.</em>
      </h1>
      <p>
        Technology. Stories. Everyday discoveries.
        <br />
        Welcome to my little corner of the internet.
      </p>
      <a class="text-link" href="/meet-vish">
        Come on in <span>↗</span>
      </a>
    </div>
    <span class="hero-caption">BENGALURU, INDIA · AN OPEN NOTEBOOK</span>
  </section>
  <section class="wrap home-stories space">
    <div class="section-heading">
      <div>
        <span class="eyebrow">FROM THE BLOG</span>
        <h2>A few things on my mind.</h2>
      </div>
      <a class="text-link" href="/blogs">
        All articles ↗
      </a>
    </div>
    <div class="story-composition">
      <a href={`/${lead.slug}`} class="lead-story">
        <img
          src={lead.image}
          alt={lead.imageAlt}
          width="1200"
          height="800"
          loading="lazy"
        />
        <div class="floating-story">
          <span class="eyebrow">OBSERVABILITY · {lead.minutes} MIN READ</span>
          <h3>{lead.title}</h3>
          <p>{lead.description}</p>
          <span class="text-link">Read the story ↗</span>
        </div>
      </a>
      <div class="side-stories">
        {selection.map((article) => (
          <NoteCard article={article} />
        ))}
      </div>
    </div>
  </section>
  <section class="reading-pair">
    <a class="room-glimpse tone-peach" href="/books">
      <span class="eyebrow">BOOKS</span>
      <div class="mini-books" aria-hidden="true">
        <span>IDEAS</span>
        <span>PERSPECTIVE</span>
        <span>DISCOVERY</span>
      </div>
      <h2>Between the pages.</h2>
      <p>What’s on my shelf, what I’m reading, and where I’m going next.</p>
      <span class="text-link">Step into the reading room ↗</span>
    </a>
    <a class="room-glimpse tone-lilac" href="/podcasts">
      <span class="eyebrow">PODCASTS</span>
      <div class="soundwave" aria-hidden="true">
        {Array.from({ length: 21 }, (_, i) => (
          <i style={`--bar:${24 + Math.sin(i * 1.8) ** 2 * 76}%`} />
        ))}
      </div>
      <h2>Worth a listen.</h2>
      <p>
        Conversations about being human, building things, and thinking a little
        deeper.
      </p>
      <span class="text-link">Open the listening room ↗</span>
    </a>
  </section>
  <section class="wrap space">
    <div class="section-heading">
      <div>
        <span class="eyebrow">PROJECTS</span>
        <h2>Ideas, out in the world.</h2>
      </div>
      <a class="text-link" href="/projects">
        All projects ↗
      </a>
    </div>
    <div class="project-glimpse">
      <a href="/projects/aroha-retreat">
        <img
          src="/images/projects/aroha.webp"
          alt="Green landscape at Aroha Retreat"
          width="1200"
          height="750"
          loading="lazy"
        />
        <span class="eyebrow">PEOPLE & PLACES</span>
        <h3>A quieter kind of project.</h3>
        <p>Aroha Retreat — a website with room to breathe.</p>
      </a>
      <a class="project-note tone-sage" href="/projects#open-source">
        <span class="eyebrow">OPEN SOURCE</span>
        <span class="code-mark" aria-hidden="true">{`{ ↗ }`}</span>
        <h3>
          Tools for the people
          <br />
          building what’s next.
        </h3>
        <p>Observability, AI agents, and a few useful experiments.</p>
        <span class="text-link">Explore the workbench ↗</span>
      </a>
    </div>
  </section>
  <section class="screen-glimpse">
    <div class="wrap screen-inner">
      <div>
        <span class="eyebrow">ENTERTAINMENT</span>
        <h2>
          Some stories stay
          <br />
          <em>after the credits.</em>
        </h2>
        <p>Movies, series, and the lessons I carry back into everyday life.</p>
        <a class="text-link" href="/entertainment">
          Read the screen notes ↗
        </a>
      </div>
      <div class="screen-art" aria-hidden="true">
        <span>
          STORIES
          <br />
          <em>worth keeping.</em>
        </span>
        <div class="film-perforations"></div>
      </div>
    </div>
  </section>
  <section class="wrap meet-glimpse space">
    <img
      src="/images/gallery/portrait-seated.webp"
      alt="Vishruth Harithsa seated in a light jacket"
      width="1200"
      height="1800"
      loading="lazy"
    />
    <div>
      <span class="eyebrow">MEET VISH</span>
      <h2>
        There’s a person
        <br />
        behind these pages.
      </h2>
      <p>
        I’m Vishruth, an engineer and builder based in Bengaluru. This is where
        the work, the interests, and the life in between come together.
      </p>
      <a class="text-link" href="/meet-vish">
        A little about me ↗
      </a>
    </div>
  </section>
</Base>
