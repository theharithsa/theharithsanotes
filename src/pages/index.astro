---
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
import { articles } from '../lib/content';
import { site } from '../data/site';
import { portrait, gallery } from '../data/gallery';
import { projects } from '../data/projects';
import ProjectArt from '../components/ProjectArt.astro';
const featured = articles.find((article) => article.slug === 'mcp-server-part-one')!;
const latest = articles.filter((article) => article !== featured).slice(0, 3);
---
<Base>
  <section class="intro-bar wrap"><p>A personal journal by <a href="/about">Vishruth Harithsa <span aria-hidden="true">↗</span></a></p><span>TECHNOLOGY. PERSPECTIVE. POSSIBILITY.</span></section>
  <section class="hero editorial-hero" aria-labelledby="hero-title">
    <img class="hero-illustration" src="/images/curiosity-editorial.webp" alt="An illustrated notebook opening into mountains, branching circuits, an observatory, and a sky of possibilities" width="1536" height="1024" fetchpriority="high" />
    <div class="hero-heading"><span class="eyebrow">THE HARITHSA NOTES · A PERSONAL JOURNAL</span><h1 id="hero-title">A curious mind.<br /><em>An open notebook.</em></h1><p>On the systems we build,<br />the things we learn,<br />and the life in between.</p><a class="underlined-link" href="/notes">Step inside the notebook <span aria-hidden="true">↗</span></a></div>
    <a class="hero-story" href={`/${featured.slug}`}><span class="eyebrow">A NOTE TO START WITH <span>↗</span></span><h2>Old systems. New possibilities.</h2><p>How MCP servers bring modern insight to managed environments.</p></a>
    <span class="hero-caption handwritten-note">Follow the questions. See where they lead.</span>
  </section>
  <section class="welcome wrap"><span class="section-kicker">HELLO, I’M VISHRUTH <span aria-hidden="true">↘</span></span><div><h2>I believe the best way to<br class="desktop-break" /> learn is to <em>stay curious.</em></h2><p>I’m a Customer Success Engineer at Dynatrace, a builder, and a lifelong student. This is where I connect the dots between the systems we build and the lives we lead.</p><a class="underlined-link" href="/about">A little more about me <span aria-hidden="true">↗</span></a></div><span class="curiosity-mark" aria-hidden="true">✳</span></section>
  <section class="notes-section wrap"><div class="section-heading"><div><span class="section-kicker">FROM MY NOTEBOOK</span><h2>The latest notes<span class="brand-dot">.</span></h2></div><a class="underlined-link" href="/notes">View all notes <span aria-hidden="true">↗</span></a></div><div class="notes-grid">{latest.map((article, index) => <NoteCard article={article} index={index} />)}</div></section>
  <section class="topics-section"><div class="wrap"><span class="section-kicker">FOLLOW YOUR CURIOSITY</span><h2>A few things on my mind.</h2><div class="topic-grid"><a href="/notes?topic=Observability"><span class="topic-symbol" aria-hidden="true">◎</span><span><h3>Seeing the unseen</h3><p>Observability, systems, and making sense of complexity.</p></span><span class="topic-arrow" aria-hidden="true">↗</span></a><a href="/notes?topic=AI+%26+building"><span class="topic-symbol" aria-hidden="true">⌘</span><span><h3>Building what’s next</h3><p>AI, open source, and ideas turned into working things.</p></span><span class="topic-arrow" aria-hidden="true">↗</span></a><a href="/notes?topic=Life+%26+learning"><span class="topic-symbol" aria-hidden="true">✳</span><span><h3>A life of learning</h3><p>Perspective, possibility, and the lessons in between.</p></span><span class="topic-arrow" aria-hidden="true">↗</span></a></div></div></section>
  <section class="selected-work wrap"><div class="section-heading"><div><span class="section-kicker">FROM THE WORKBENCH</span><h2>Ideas with a life<br /><em>of their own.</em></h2></div><a class="underlined-link" href="/projects">See what I’m building ↗</a></div><div class="selected-projects">{projects.slice(0,3).map(project=><article><a href={project.href} tabindex="-1" aria-hidden="true"><ProjectArt project={project}/></a><span class="eyebrow">{project.category}</span><h3><a href={project.href}>{project.title}</a></h3><p>{project.description}</p></article>)}</div></section>
  <section class="personal-section wrap"><div class="portrait-frame updated-portrait"><img src={portrait} alt="Vishruth Harithsa seated in a light jacket" width="1200" height="1800" loading="lazy"/><span>BENGALURU, INDIA · ALWAYS A STUDENT</span></div><div class="personal-copy"><span class="section-kicker">BEYOND THE CODE</span><h2>Technology is interesting.<br /><em>People make it matter.</em></h2><p>The most rewarding part of what I do is helping someone else take their next step. Whether you’re finding your way in observability, exploring an idea, or figuring out a career in technology, let’s talk.</p><a href={site.mentoring} class="button">Find time for a conversation <span aria-hidden="true">↗</span></a></div></section>
  <section class="camera-roll wrap"><div class="section-heading"><div><span class="section-kicker">A FEW MOMENTS ALONG THE WAY</span><h2>Life outside the tabs.</h2></div><a class="underlined-link" href="/gallery">Open the camera roll ↗</a></div><div class="photo-strip">{[gallery[0],gallery[2],gallery[4]].map(photo=><a href="/gallery"><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy"/><span>{photo.title}</span></a>)}</div></section>
  <section class="closing-note wrap"><span class="eyebrow">THE NOTEBOOK IS OPEN</span><h2>Good ideas are better<br />when they’re shared.</h2><p>Follow the things I’m learning, writing, and building.</p><div><a class="button" href={site.linkedin}>Follow on LinkedIn ↗</a><a class="underlined-link" href="/rss.xml">Subscribe via RSS ↗</a></div><span class="signature">Vishruth</span></section>
</Base>
