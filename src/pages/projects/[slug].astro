---
import { sanitizePostHtml } from "../../lib/post-html";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import ProjectArt from "../../components/ProjectArt.astro";
import ProjectScreenshot from "../../components/ProjectScreenshot.astro";
import Base from "../../layouts/Base.astro";
import {
  projects as snapshotProjects,
  type Project,
} from "../../data/projects";
import { detail } from "../../lib/journal";
export const getStaticPaths = (() =>
  snapshotProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const loaded = Astro.props.project
  ? { data: Astro.props.project, canonical: Astro.props.project.slug }
  : await detail<Project>(
      "projects",
      Astro.params.slug ?? "",
      snapshotProjects,
    );
if (!loaded) return Astro.rewrite("/404");
if (loaded.canonical !== Astro.params.slug)
  return Astro.redirect(`/projects/${loaded.canonical}`, 301);
const project = loaded.data;
const { productHunt } = project;
---

<Base
  title={project.title}
  description={project.description}
  image={project.image}
>
  <article class="projects-technical project-details post-page">
    <div class="wrap project-detail-top">
      <a class="workbench-back" href={`/projects#${project.slug}`}>
        ← All projects
      </a>
      <span class="workbench-meta">{project.category} / PROJECT NOTES</span>
    </div>
    <header class="wrap project-story-hero">
      <figure class="project-detail-cover">
        <ProjectArt project={project} detail />
        <figcaption>Original illustration / {project.title}</figcaption>
      </figure>
      <div class="project-story-intro">
        <span class="eyebrow">FROM THE WORKBENCH</span>
        <h1>{project.title}</h1>
        <p class="project-story-deck">{project.description}</p>
        <div class="project-story-actions">
          {project.href && (
            <a class="project-visit" href={project.href}>
              {project.linkLabel}
              <span aria-hidden="true">↗</span>
            </a>
          )}
          {project.source && (
            <a class="project-source" href={project.source}>
              GitHub repository ↗
            </a>
          )}
          {productHunt && (
            <a
              class="project-product-hunt"
              href={`https://www.producthunt.com/products/${encodeURIComponent(productHunt.slug)}?launch=${encodeURIComponent(productHunt.slug)}`}
            >
              <img
                src={`https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=${encodeURIComponent(productHunt.postId)}&theme=light`}
                alt={`${project.title} on Product Hunt`}
                width="250"
                height="54"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
          )}
        </div>
        <div class="project-stack">
          <h2>Built with</h2>
          <ul>
            {project.stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </header>
    <div class="wrap project-detail-layout">
      <div class="project-detail-story post-body">
        <section aria-labelledby="overview-heading">
          <span class="workbench-meta">01 / THE IDEA</span>
          <h2 id="overview-heading">What it does</h2>
          {project.overview.map((paragraph, index) => (
            <>
              <p>{paragraph}</p>
              {project.screenshots
                ?.filter(({ afterParagraph }) => afterParagraph === index + 1)
                .map((screenshot) => (
                  <ProjectScreenshot screenshot={screenshot} />
                ))}
            </>
          ))}
        </section>
        <section
          class="project-capabilities"
          aria-labelledby="capabilities-heading"
        >
          <span class="workbench-meta">02 / INSIDE THE PROJECT</span>
          <h2 id="capabilities-heading">A closer look</h2>
          <div class="project-feature-grid">
            {project.features.map((feature) => (
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
                {feature.screenshots?.map((screenshot) => (
                  <ProjectScreenshot screenshot={screenshot} />
                ))}
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
    <div class="wrap">
      {project.html && (
        <div
          class="post-body post-extra-body"
          set:html={sanitizePostHtml(project.html, true)}
        />
      )}
    </div>
  </article>
</Base>

<style>
  .project-story-actions:has(.project-product-hunt) {
    column-gap: 0.75rem;
  }

  .project-product-hunt {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    max-inline-size: 100%;
  }

  .project-product-hunt img {
    display: block;
    inline-size: 11.5rem;
    max-inline-size: 100%;
    block-size: auto;
  }
</style>
