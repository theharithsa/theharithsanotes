---
import Base from "../layouts/Base.astro";
import ProjectArt from "../components/ProjectArt.astro";
import { getProjects } from "../lib/journal";
const projects = await getProjects();
const projectTopics = [...new Set(projects.map((project) => project.category))];
---

<Base
  title="Projects"
  image={projects[0]?.image}
  description="The workbench: products, experiments and open-source tools by Vishruth Harithsa."
>
  <div class="projects-technical">
    <header class="workbench-header wrap">
      <div class="workbench-intro-title">
        <span class="eyebrow">PROJECTS / THE WORKBENCH</span>
        <h1>
          A few ideas.
          <br />
          <span>Out in the world.</span>
        </h1>
      </div>
      <div class="workbench-intro-note">
        <p>
          Some start with a problem. Others with a little curiosity. These are
          the products, tools and experiments I keep coming back to.
        </p>
        <span class="workbench-count">
          {String(projects.length).padStart(2, "0")} projects &amp; counting{" "}
          <span aria-hidden="true">↘</span>
        </span>
      </div>
    </header>
    <section
      class="wrap workbench-section"
      aria-labelledby="projects-heading"
      id="open-source"
    >
      <div class="workbench-section-heading">
        <h2 id="projects-heading">Projects</h2>
        <span>Explore the story behind the code ↓</span>
      </div>
      <div
        class="filters project-filters"
        aria-label="Filter projects by topic"
      >
        {["All projects", ...projectTopics].map((topic, index) => (
          <button
            data-project-filter={topic}
            aria-pressed={index === 0}
            aria-controls="project-results"
          >
            {topic}
            <span class="filter-count">
              {index === 0
                ? projects.length
                : projects.filter((project) => project.category === topic)
                    .length}
            </span>
          </button>
        ))}
      </div>
      <p id="project-count" class="result-count" aria-live="polite">
        {projects.length} projects
      </p>
      <div class="workbench-grid project-mosaic" id="project-results">
        {projects.map((project, index) => (
          <article
            class="workbench-card"
            id={project.slug}
            data-project
            data-topic={project.category}
          >
            <a
              class="workbench-cover"
              href={`/projects/${project.slug}`}
              tabindex="-1"
              aria-hidden="true"
            >
              <ProjectArt project={project} />
            </a>
            <div class="workbench-card-copy">
              <span class="workbench-meta">
                {String(index + 1).padStart(2, "0")} / {project.category}
              </span>
              <h3>
                <a href={`/projects/${project.slug}`}>{project.title}</a>
              </h3>
              <p>{project.description}</p>
              <a
                class="workbench-read"
                href={`/projects/${project.slug}`}
                aria-label={`Read about ${project.title}`}
              >
                Project notes <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>
