---
import Base from '../layouts/Base.astro';
const projects = [
  { number: '01', category: 'OPEN SOURCE · OBSERVABILITY', title: 'Dynatrace MCP', description: 'Connecting AI assistants with observability context. My work includes contributions to the Dynatrace MCP server.', href: 'https://github.com/dynatrace-oss/dynatrace-mcp', symbol: '◎' },
  { number: '02', category: 'AI · DEVELOPER TOOLING', title: 'Copilot, meet OpenTelemetry', description: 'Reusable instrumentation for GitHub Copilot SDK agents, with telemetry exported to Dynatrace.', href: 'https://www.npmjs.com/package/@theharithsa/github_copilot_otel', symbol: '⌘' },
  { number: '03', category: 'PERSONAL FINANCE · BUILDING', title: 'My FinBuddy', description: 'A side project exploring how technology can help make personal finance easier to understand.', href: 'https://myfinbuddy.in', symbol: '↗' },
  { number: '04', category: 'DEVELOPER EXPERIENCE · FOUNDATION', title: 'App Launchpad', description: 'A foundation for building applications with explicit decisions, delivery evidence, and observability from the start.', href: 'https://github.com/theharithsa/app-launchpad-template', symbol: '✳' },
];
---
<Base title="Things I build"><section class="page-intro wrap"><span class="section-kicker">FROM CURIOSITY TO CODE</span><h1>Things I build<span class="brand-dot">.</span></h1><p>Experiments, open-source contributions, and ideas that became something you can use.</p></section><section class="project-grid wrap" aria-label="Projects">{projects.map((project) => <a class="project-card" href={project.href}><div class="project-art"><span>{project.symbol}</span><small>{project.number} / FIELD WORK</small></div><div class="project-copy"><span class="eyebrow">{project.category}</span><h2>{project.title}</h2><p>{project.description}</p><span class="underlined-link">Explore the project ↗</span></div></a>)}</section><section class="closing-note wrap"><span class="eyebrow">BUILT IN THE OPEN</span><h2>The next idea<br />starts with a question.</h2><p>Explore my repositories, or bring a question of your own.</p><a class="button" href="https://github.com/theharithsa">Find me on GitHub ↗</a></section></Base>
