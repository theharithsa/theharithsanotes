---
import Base from '../layouts/Base.astro';
import ProjectArt from '../components/ProjectArt.astro';
import { projects } from '../data/projects';
---
<Base title="Things I build">
  <section class="page-intro wrap project-intro"><span class="section-kicker">THE WORKBENCH</span><h1>Curiosity,<br /><em>put to work.</em></h1><p>Some ideas become notes. Others become things you can use. Here are a few of mine, from observability tools to places for people to learn, plan, and connect.</p><span class="handwritten-note">Always a work in progress ↘</span></section>
  <section class="project-grid wrap expanded-projects" aria-label="Projects">
    {projects.slice(0,4).map((project, index) => <article class="project-card"><a href={project.href} class="project-image-link" tabindex="-1" aria-hidden="true"><ProjectArt project={project}/></a><div class="project-copy"><span class="eyebrow">{String(index + 1).padStart(2, '0')} / {project.category}</span><h2><a href={project.href}>{project.title}</a></h2><p>{project.description}</p><div class="project-links"><a class="underlined-link" href={project.href}>Explore the project ↗</a>{project.source && project.source !== project.href && <a href={project.source} class="source-link">Source on GitHub ↗</a>}</div></div></article>)}
  </section>
  <section class="project-index wrap"><span class="section-kicker">MORE FROM THE WORKBENCH</span>{projects.slice(4).map((project,index)=><article><span class="project-index-number">{String(index+5).padStart(2,'0')}</span><div><span class="eyebrow">{project.category}</span><h2><a href={project.href}>{project.title}</a></h2><p>{project.description}</p></div><a href={project.href} class="project-index-arrow" aria-label={`Explore ${project.title}`}>↗</a></article>)}</section>
  <section class="closing-note wrap"><span class="eyebrow">THE NEXT CHAPTER</span><h2>There’s always<br />another idea.</h2><p>Follow the experiments as they grow.</p><a class="button" href="https://github.com/theharithsa">Explore my GitHub ↗</a></section>
</Base>
