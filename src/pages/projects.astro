---
import Base from "../layouts/Base.astro";
import ProjectArt from "../components/ProjectArt.astro";
import { projects } from "../data/projects";
---

<Base title="Projects">
  <section class="section-masthead tone-sage">
    <div class="wrap">
      <span class="eyebrow">THE WORKBENCH</span>
      <h1>Projects</h1>
      <p>
        Products for everyday life. Tools for people who build. A few ideas that
        escaped the notebook.
      </p>
    </div>
  </section>
  <section class="project-grid wrap expanded-projects" aria-label="Projects">
    {projects.slice(0, 4).map((project, index) => (
      <article class="project-card" id={project.slug}>
        <a
          href={project.href}
          class="project-image-link"
          tabindex="-1"
          aria-hidden="true"
        >
          <ProjectArt project={project} />
        </a>
        <div class="project-copy">
          <span class="eyebrow">
            {String(index + 1).padStart(2, "0")} / {project.category}
          </span>
          <h2>
            <a href={project.href}>{project.title}</a>
          </h2>
          <p>{project.description}</p>
          <div class="project-links">
            <a class="underlined-link" href={project.href}>
              Explore the project ↗
            </a>
            {project.source && project.source !== project.href && (
              <a href={project.source} class="source-link">
                Source on GitHub ↗
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>
  <section class="project-index wrap technical-workbench" id="open-source">
    <span class="section-kicker">MORE FROM THE WORKBENCH</span>
    {projects.slice(4).map((project, index) => (
      <article id={project.slug}>
        <span class="project-index-number">
          {String(index + 5).padStart(2, "0")}
        </span>
        <div>
          <span class="eyebrow">{project.category}</span>
          <h2>
            <a href={project.href}>{project.title}</a>
          </h2>
          <p>{project.description}</p>
        </div>
        <a
          href={project.href}
          class="project-index-arrow"
          aria-label={`Explore ${project.title}`}
        >
          ↗
        </a>
      </article>
    ))}
  </section>
</Base>
