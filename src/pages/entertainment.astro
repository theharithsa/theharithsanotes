---
import Base from "../layouts/Base.astro";
import ScreenArt from "../components/ScreenArt.astro";
import { screenNotes } from "../data/screen-notes";
import { articles, formatDate } from "../lib/content";
const [lead, ...otherNotes] = screenNotes;
const senna = articles.find((article) =>
  article.slug.includes("ayrton-senna"),
)!;
---

<Base title="Entertainment">
  <section class="section-masthead tone-ochre">
    <div class="wrap">
      <span class="eyebrow">MOVIES, SERIES & THE LIFE BETWEEN</span>
      <h1>Entertainment</h1>
      <p>The story ends. The thinking doesn’t.</p>
    </div>
  </section>
  <section class="wrap space screen-lead">
    <a href={`/entertainment/${lead.slug}`} tabindex="-1" aria-hidden="true">
      <ScreenArt note={lead} />
    </a>
    <div>
      <span class="eyebrow">
        {lead.kind} · {lead.title}
      </span>
      <h2>
        <a href={`/entertainment/${lead.slug}`}>{lead.headline}</a>
      </h2>
      <p>{lead.description}</p>
      <a class="text-link" href={`/entertainment/${lead.slug}`}>
        Read the reflection ↗
      </a>
      <p class="screen-title-link">
        <a
          class="text-link"
          href={lead.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {lead.linkLabel} ↗
        </a>
      </p>
      <p class="screen-note-date">From my notes · {formatDate(lead.date)}</p>
    </div>
  </section>
  <section class="wrap screen-journal" aria-labelledby="screen-journal-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">FROM MY VIEWING NOTES</span>
        <h2 id="screen-journal-heading">Stories I’m still thinking about.</h2>
      </div>
    </div>
    <div class="filters" aria-label="Filter screen notes">
      {["All notes", "Movies", "Series"].map((filter, index) => (
        <button data-screen-filter={filter} aria-pressed={index === 0}>
          {filter}
        </button>
      ))}
    </div>
    <p id="screen-count" class="result-count" aria-live="polite">
      {otherNotes.length} reflections
    </p>
    <div class="screen-notes-grid">
      {otherNotes.map((note) => (
        <article
          class="screen-note-card"
          data-screen-note
          data-kind={note.kind}
        >
          <a
            href={`/entertainment/${note.slug}`}
            tabindex="-1"
            aria-hidden="true"
          >
            <ScreenArt note={note} />
          </a>
          <div class="screen-card-copy">
            <span class="eyebrow">
              {note.kind} · {note.title}
            </span>
            <h3>
              <a href={`/entertainment/${note.slug}`}>{note.headline}</a>
            </h3>
            <p>{note.description}</p>
            <p class="screen-card-lesson">
              <span>WHAT STAYED WITH ME</span>
              {note.lesson}
            </p>
            <p class="screen-title-link">
              <a
                class="text-link"
                href={note.officialUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {note.linkLabel} ↗
              </a>
            </p>
            <div class="screen-card-footer">
              <time datetime={note.date}>{formatDate(note.date)}</time>
              <a href={`/entertainment/${note.slug}`} class="text-link">
                Read the note ↗
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="wrap screen-archive">
    <div>
      <span class="eyebrow">A LONGER READ · FROM THE BLOG</span>
      <h2>And the story that started this corner.</h2>
    </div>
    <a href={`/${senna.slug}`} class="senna-archive">
      <img
        src={senna.image}
        alt={senna.imageAlt}
        width="1200"
        height="800"
        loading="lazy"
      />
      <div>
        <span class="eyebrow">SENNA · AMBITION & PERSPECTIVE</span>
        <h3>Chasing greatness, without losing perspective.</h3>
        <p>{senna.description}</p>
        <span class="text-link">Read the essay ↗</span>
      </div>
    </a>
  </section>
</Base>
