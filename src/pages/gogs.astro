---
import Base from "../layouts/Base.astro";
import EditorialImage from "../components/EditorialImage.astro";
---

<Base
  title="Games and Gadget (GoGs)"
  description="GoGs is Vishruth Harithsa’s space for games, gadgets, and everyday experiences. The first personal stories are coming soon."
  image="/images/navigation/gogs-portrait-v1.png"
  imageAlt="An illustrated Vishruth enjoying a game, surrounded by everyday technology"
>
  <section class="gogs-hero wrap">
    <div>
      <span class="eyebrow">GAMES AND GADGET · GoGs</span>
      <h1>
        Press pause.
        <br />
        <em>Find a little wonder.</em>
      </h1>
      <p>
        A space for the games I play, the gadgets I use, and the little
        experiences that make life more interesting.
      </p>
      <span class="gogs-label">A new chapter, coming soon.</span>
    </div>
    <EditorialImage
      src="/images/navigation/gogs-portrait-v1.png"
      alt="An illustrated Vishruth enjoying a game, surrounded by everyday technology"
      eager
      sizes="(max-width: 760px) 92vw, 50vw"
    />
  </section>
  <section class="gogs-notebook wrap" aria-label="Future GoGs journals">
    <div id="games">
      <span class="eyebrow">01 / GAMES</span>
      <h2>Beyond the next level.</h2>
      <p>
        Playthroughs, worlds worth getting lost in, and the moments that stay
        with me after the screen goes quiet.
      </p>
      <span class="gogs-label">First experiences to come</span>
    </div>
    <div id="gadgets">
      <span class="eyebrow">02 / GADGETS</span>
      <h2>Things that earn their place.</h2>
      <p>
        Everyday tools, small discoveries, and what it’s actually like to live
        with the technology around me.
      </p>
      <span class="gogs-label">Notes will appear here</span>
    </div>
  </section>
</Base>
