---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import BookJacket from "../../components/BookJacket.astro";
import BookRating from "../../components/BookRating.astro";
import { completedBooks as snapshotBooks, type Book } from "../../data/books";
import { detail } from "../../lib/journal";
export const getStaticPaths = (() =>
  snapshotBooks.map((book, index) => ({
    params: { slug: book.slug },
    props: { book, index },
  }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const loaded = Astro.props.book
  ? { data: Astro.props.book, canonical: Astro.props.book.slug }
  : await detail<Book>("books", Astro.params.slug ?? "", snapshotBooks);
if (!loaded) return Astro.rewrite("/404");
if (loaded.canonical !== Astro.params.slug)
  return Astro.redirect(`/books/${loaded.canonical}`, 301);
const book = loaded.data;
const index = Astro.props.index ?? 0;
const entry = book.goodreads ?? {
  sourceReviewId: book.slug ?? "",
  title: book.title,
  author: book.author,
  rating: 0,
  shelves: ["read"],
  review: "",
  dateRead: [],
  goodreadsUrl: "",
  reviewUrl: "",
};
const paragraphs = entry.review.split(/\n\s*\n/).filter(Boolean);
---

<Base
  title={book.title}
  description={`My reading journal for ${book.title} by ${book.author}.${entry.rating > 0 ? ` Rated ${entry.rating} out of 5.` : ""}`}
  structuredData={{
    "@type": "Book",
    name: book.title,
    author: {
      "@type": book.author.startsWith("Harvard Business")
        ? "Organization"
        : "Person",
      name: book.author,
    },
    genre: book.genres,
    sameAs: entry.goodreadsUrl,
    ...(entry.rating > 0
      ? {
          review: {
            "@type": "Review",
            author: { "@id": "https://theharithsanotes.com/meet-vish#person" },
            reviewRating: {
              "@type": "Rating",
              ratingValue: entry.rating,
              bestRating: 5,
              worstRating: 1,
            },
            ...(entry.review ? { reviewBody: entry.review } : {}),
          },
        }
      : {}),
  }}
>
  <article class="book-journal post-page wrap">
    <a
      class="text-link book-journal-back"
      href={`/books#book-${entry.sourceReviewId}`}
    >
      ← Back to the bookshelf
    </a>
    <div class="book-journal-layout">
      <aside class="book-journal-jacket" aria-label="Book details">
        <div aria-hidden="true">
          <BookJacket book={book} index={index} />
        </div>
        {entry.goodreadsUrl && (
          <a class="text-link" href={entry.goodreadsUrl}>
            Book on Goodreads ↗
          </a>
        )}
      </aside>
      <div class="book-journal-reading">
        <header>
          <span class="eyebrow">THE READING JOURNAL · READ</span>
          <h1>{book.title}</h1>
          <p class="book-journal-author">{book.author}</p>
          <BookRating rating={entry.rating} />
          {entry.dateRead.length > 0 && (
            <p class="book-read-date">Finished {entry.dateRead.join(" · ")}</p>
          )}
        </header>
        {paragraphs.length > 0 && (
          <section
            class="book-review post-body"
            aria-labelledby="review-heading"
          >
            <h2 id="review-heading">My notes from the book.</h2>
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        )}
        <footer class="book-review-source">
          <p>
            My rating{entry.review ? " and original review" : ""}, first shared
            on Goodreads.
          </p>
          <a class="text-link" href={entry.reviewUrl}>
            View my Goodreads entry ↗
          </a>
        </footer>
      </div>
    </div>
  </article>
</Base>
