---
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
import { articles, formatDate, type Article } from '../lib/content';
import { avatar } from '../data/gallery';
export function getStaticPaths() { return articles.map((article) => ({ params: { slug: article.slug }, props: { article } })); }
interface Props { article: Article }
const { article } = Astro.props;
const related = articles.filter((note) => note.slug !== article.slug && note.topic === article.topic).slice(0, 2);
const headings = [...article.html.matchAll(/<h[23]\s+id="([^"]+)"[^>]*>([\s\S]*?)<\/h[23]>/g)].filter(match=> !article.html.includes('<h2 ') || match[0].startsWith('<h2')).map(match=>({id:match[1],text:match[2].replace(/<[^>]+>/g,'')}));
---
<Base title={article.title} description={article.description} image={article.image} article>
  <article class="article-page">
    <header class="article-header wrap"><a class="back-link" href="/notes">← Back to the notebook</a><span class="eyebrow">{article.topic}</span><h1>{article.title}</h1><p class="article-deck">{article.description}</p><div class="article-byline"><img src={avatar} width="44" height="44" alt=""/><span>By <a href="/about">Vishruth Harithsa</a><br /><time datetime={article.date}>{formatDate(article.date)}</time> · {article.minutes} min read</span><button class="text-button" data-copy-link aria-live="polite">Copy link ↗</button></div>{article.sourceLabel && <p class="article-source">Originally published on {article.sourceLabel} · <a href={article.source}>Read the original ↗</a></p>}</header>
    <figure class="article-cover wrap"><img src={article.image} alt={article.imageAlt} width="1400" height="800" fetchpriority="high"/><figcaption>{article.imageCredit ?? `A note from the archive · Originally published ${formatDate(article.date)}`}</figcaption></figure>
    <div class="article-reading-layout wrap">
      {headings.length>1 && <aside class="article-outline"><details><summary>In this note</summary><nav aria-label="Article contents"><ol>{headings.map(heading=><li><a href={`#${heading.id}`} set:html={heading.text}/></li>)}</ol></nav></details></aside>}
      <div class="article-body" set:html={article.html}/>
      <div class="article-margin-note" aria-hidden="true">a thought,<br />worth following.<span>↘</span></div>
    </div>
    <div class="article-end"><span aria-hidden="true">✳</span><p>Thanks for reading.<br />There’s always more to learn.</p><a href="/notes" class="underlined-link">Explore the notebook ↗</a></div>
  </article>
  {related.length > 0 && <section class="wrap related"><div class="section-heading"><h2>Keep exploring.</h2><a href="/notes" class="underlined-link">All notes ↗</a></div><div class="notes-grid notes-grid-two">{related.map((note, index) => <NoteCard article={note} index={index}/>)}</div></section>}
</Base>
