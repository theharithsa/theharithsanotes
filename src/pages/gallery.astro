---
import { getJournalPage } from "../lib/journal";
import PageHeading from "../components/PageHeading.astro";
import PageParagraphs from "../components/PageParagraphs.astro";
const page = await getJournalPage("gallery");
import Base from "../layouts/Base.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
---

<Base
  title={page.title}
  description={page.description}
  image={page.image || undefined}
>
  <section class="page-intro wrap gallery-intro">
    <span class="section-kicker">A DIFFERENT KIND OF NOTE</span>
    <h1>
      <PageHeading text={page.heading ?? page.title} />
    </h1>
    <p>{page.description}</p>
    <span class="handwritten-note">
      A little less code. A little more life.
    </span>
  </section>
  <PageParagraphs paragraphs={page.paragraphs} />
  <section class="wrap gallery-section" aria-label="Personal photographs">
    <GalleryGrid />
  </section>
  <section class="closing-note wrap">
    <span class="eyebrow">BEHIND EVERY PROJECT</span>
    <h2>
      A person.
      <br />A story. A connection.
    </h2>
    <a href="/about" class="underlined-link">
      Meet the person behind the notes ↗
    </a>
  </section>
</Base>
