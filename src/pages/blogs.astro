---
import PageParagraphs from "../components/PageParagraphs.astro";
import Base from "../layouts/Base.astro";
import NoteCard from "../components/NoteCard.astro";
import { getArticles, getJournalPage } from "../lib/journal";
const page = await getJournalPage("blogs");
const articles = await getArticles();
import { topics as originalTopics } from "../data/site";
const topics = [
  ...new Set([...originalTopics, ...articles.map((article) => article.topic)]),
];
const tags = [
  ...new Set(articles.flatMap((article) => article.tags ?? [article.topic])),
].sort();
const byMonth = new Map<string, typeof articles>();
for (const article of articles) {
  const key = article.date.slice(0, 7);
  const group = byMonth.get(key) ?? [];
  group.push(article);
  byMonth.set(key, group);
}
const months = [...byMonth].map(([key, items]) => ({
  key,
  items,
  year: key.slice(0, 4),
  label: new Intl.DateTimeFormat("en-IN", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${key}-01T00:00:00Z`)),
  short: new Intl.DateTimeFormat("en-IN", {
    month: "short",
    timeZone: "UTC",
  }).format(new Date(`${key}-01T00:00:00Z`)),
}));
const years = [...new Set(months.map((month) => month.year))];
---

<Base
  title={page.title}
  description={page.description}
  image={page.image || undefined}
>
  <section class="section-masthead tone-blue">
    <div class="wrap">
      <span class="eyebrow">THE WRITTEN WORD</span>
      <h1>{page.heading ?? page.title}</h1>
      <p>{page.description}</p>
    </div>
    <label class="date-jump-mobile">
      Jump through the archive{" "}
      <select data-blog-date-picker>
        <option value="">Choose a month or year</option>
        {years.map((year) => (
          <optgroup label={year}>
            {months
              .filter((month) => month.year === year)
              .map((month) => (
                <option value={month.key}>
                  {month.label} · {month.items.length}
                </option>
              ))}
          </optgroup>
        ))}
      </select>
    </label>
  </section>
  <PageParagraphs paragraphs={page.paragraphs} />
  <section class="archive wrap space" aria-label="Browse blog articles">
    <div class="archive-tools">
      <div class="filters" aria-label="Filter by topic">
        {topics.map((topic) => (
          <button data-filter={topic} aria-pressed={topic === "All notes"}>
            {topic === "All notes" ? "All articles" : topic}
          </button>
        ))}
      </div>
      <label class="blog-tag-picker" for="blog-tag-filter">
        <span>Explore a tag</span>
        <select id="blog-tag-filter" aria-label="Filter articles by tag">
          <option value="">All tags</option>
          {tags.map((tag) => (
            <option value={tag}>{tag}</option>
          ))}
        </select>
      </label>
    </div>
    <p id="result-count" class="result-count" aria-live="polite">
      {articles.length} articles
    </p>
    <div class="blog-time-layout">
      <nav class="journal-timeline" aria-label="Blog archive by date">
        <span class="timeline-label">THE ARCHIVE</span>
        {years.map((year) => (
          <div class="timeline-year" data-year={year}>
            <button
              class="timeline-year-button"
              aria-expanded="false"
              aria-controls={`months-${year}`}
              data-year-jump={year}
            >
              {year}
            </button>
            <div class="timeline-months" id={`months-${year}`} hidden>
              {months
                .filter((month) => month.year === year)
                .map((month) => (
                  <a
                    href={`#archive-${month.key}`}
                    data-month-jump={month.key}
                    aria-label={`${month.label}, ${month.items.length} articles`}
                  >
                    {month.short}
                    <span>{month.items.length}</span>
                  </a>
                ))}
            </div>
          </div>
        ))}
      </nav>
      <div class="dated-articles">
        {months.map((month) => (
          <section
            class="blog-month-group"
            id={`archive-${month.key}`}
            data-date-group={month.key}
          >
            <h2 class="archive-date-heading">
              <time datetime={month.key}>{month.label}</time>
              <span aria-hidden="true"></span>
            </h2>
            <div class="notes-grid">
              {month.items.map((article) => (
                <NoteCard article={article} />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
    <div id="empty-state" class="empty-state" hidden>
      <h2>No articles found.</h2>
      <p>Try another tag or topic.</p>
      <button class="button" data-reset-search>
        Show all articles
      </button>
    </div>
  </section>
  <script src="../scripts/blog-timeline.ts"></script>
</Base>
