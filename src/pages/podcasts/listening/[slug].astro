---
import { sanitizePostHtml } from "../../../lib/post-html";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "../../../layouts/Base.astro";
import PodcastArt from "../../../components/PodcastArt.astro";
import {
  listening as snapshotListening,
  type ListeningNote,
} from "../../../data/interests";
import { detail } from "../../../lib/journal";
export const getStaticPaths = (() =>
  snapshotListening.map((note, index) => ({
    params: { slug: note.slug },
    props: { note, index },
  }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const loaded = Astro.props.note
  ? { data: Astro.props.note, canonical: Astro.props.note.slug }
  : await detail<ListeningNote>(
      "podcasts",
      Astro.params.slug ?? "",
      snapshotListening,
    );
if (!loaded) return Astro.rewrite("/404");
if (loaded.data.kind === "created")
  return Astro.redirect(`/podcasts/created/${loaded.canonical}`, 301);
if (loaded.canonical !== Astro.params.slug)
  return Astro.redirect(`/podcasts/listening/${loaded.canonical}`, 301);
const note = loaded.data;
const index = Astro.props.index ?? 0;
---

<Base title={note.title} description={note.note}>
  <article class="podcast-room podcast-detail post-page">
    <div class="wrap project-detail-top">
      <a class="workbench-back" href={`/podcasts#${note.slug}`}>
        ← Listening notes
      </a>
      <span class="workbench-meta">LISTENING / {note.status}</span>
    </div>
    <header class="wrap project-story-hero">
      <PodcastArt note={note} index={index} />
      <div class="project-story-intro">
        <span class="eyebrow">THE LISTENING ROOM</span>
        <h1>{note.title}</h1>
        <p class="show-name">{note.show}</p>
        <p class="project-story-deck post-body">{note.note}</p>
        <a class="project-visit" href={note.href}>
          Open the episode <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <div class="wrap">
      {note.html && (
        <div
          class="post-body post-extra-body"
          set:html={sanitizePostHtml(note.html)}
        />
      )}
    </div>
    <div class="wrap podcast-detail-footer">
      <a class="text-link" href="/podcasts">
        More listening notes
      </a>
      <a class="text-link" href="/podcasts/created">
        Created conversations
      </a>
    </div>
  </article>
</Base>
