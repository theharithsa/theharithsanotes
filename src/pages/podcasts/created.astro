---
import Base from "../../layouts/Base.astro";
import FilterPanel from "../../components/FilterPanel.astro";
import PodcastArt from "../../components/PodcastArt.astro";
import { getListening } from "../../lib/journal";
const created = (await getListening()).filter(
  (note) => note.kind === "created",
);
---

<Base
  title="Created podcasts"
  description="A space for conversations by Vishruth Harithsa."
>
  <section class="wrap podcast-room created-room space">
    <FilterPanel label="Collections">
      <nav class="podcast-tabs" aria-label="Podcast collections">
        <a href="/podcasts">Listening</a>
        <a href="/podcasts/created" aria-current="page">
          Created
        </a>
      </nav>
    </FilterPanel>
    <span class="eyebrow">MY CONVERSATIONS</span>
    <h1>Created.</h1>
    <p>A space for conversations of my own, when they’re ready.</p>
    {created.length ? (
      <div class="podcast-mosaic">
        {created.map((note, index) => (
          <a class="podcast-card" href={`/podcasts/created/${note.slug}`}>
            <PodcastArt note={note} index={index} />
            <h2>{note.title}</h2>
            <p>{note.note}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="created-empty" aria-label="No created episodes yet"></div>
    )}
  </section>
</Base>
