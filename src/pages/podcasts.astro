---
import PodcastArt from "../components/PodcastArt.astro";
import FilterPanel from "../components/FilterPanel.astro";
import PageParagraphs from "../components/PageParagraphs.astro";
import Base from "../layouts/Base.astro";
import { getListening, getJournalPage } from "../lib/journal";
import PageHeading from "../components/PageHeading.astro";
const page = await getJournalPage("podcasts");
const listening = (await getListening()).filter(
  (note) => note.kind !== "created",
);
---

<Base
  title={page.title}
  description={page.description}
  image={page.image || undefined}
>
  <section class="podcast-hero tone-lilac">
    <div class="wrap">
      <span class="eyebrow">THE LISTENING ROOM</span>
      <h1>
        <PageHeading text={page.heading ?? page.title} />
      </h1>
      <p>{page.description}</p>
      <div class="soundwave" aria-hidden="true">
        {Array.from({ length: 45 }, (_, i) => (
          <i style={`--bar:${15 + Math.sin(i * 1.7) ** 2 * 85}%`} />
        ))}
      </div>
    </div>
  </section>
  <PageParagraphs paragraphs={page.paragraphs} />
  <section
    class="wrap podcast-room podcast-collection space"
    aria-labelledby="listening-heading"
  >
    <FilterPanel label="Collections">
      <nav class="podcast-tabs" aria-label="Podcast collections">
        <a href="/podcasts" aria-current="page">
          Listening
        </a>
        <a href="/podcasts/created">Created</a>
      </nav>
    </FilterPanel>
    <div class="section-heading">
      <div>
        <span class="eyebrow">EPISODES &amp; IDEAS</span>
        <h2 id="listening-heading">In the queue &amp; in my notes.</h2>
      </div>
      <span>{listening.length} listening notes</span>
    </div>
    <div class="workbench-grid podcast-mosaic">
      {listening.map((note, index) => (
        <article class="workbench-card" id={note.slug}>
          <a
            class="workbench-cover podcast-cover"
            href={`/podcasts/listening/${note.slug}`}
            tabindex="-1"
            aria-hidden="true"
          >
            <PodcastArt note={note} index={index} />
          </a>
          <div class="workbench-card-copy">
            <span class="workbench-meta">
              {note.status} / {String(index + 1).padStart(2, "0")}
            </span>
            <h3>
              <a href={`/podcasts/listening/${note.slug}`}>{note.title}</a>
            </h3>
            <p class="show-name">{note.show}</p>
            <p>{note.note}</p>
            <a
              class="workbench-read"
              href={`/podcasts/listening/${note.slug}`}
              aria-label={`Read listening note: ${note.title}`}
            >
              Open the listening note <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
