---
import PageParagraphs from "../components/PageParagraphs.astro";
import FilterPanel from "../components/FilterPanel.astro";
import Base from "../layouts/Base.astro";
import { getBooks, getJournalPage } from "../lib/journal";
import PageHeading from "../components/PageHeading.astro";
const page = await getJournalPage("books");
import { genres as originalGenres } from "../data/books";
const books = await getBooks();
const completedBooks = books;
const genres = [
  ...new Set([...originalGenres, ...books.flatMap((book) => book.genres)]),
];
import BookJacket from "../components/BookJacket.astro";
import BookRating from "../components/BookRating.astro";
---

<Base
  title={page.title}
  description={page.description}
  image={page.image || undefined}
>
  <section class="reading-hero tone-peach">
    <div class="wrap">
      <div>
        <span class="eyebrow">THE READING ROOM</span>
        <h1>
          <PageHeading text={page.heading ?? page.title} />
        </h1>
        <p>{page.description}</p>
        <a href="#bookshelf" class="text-link">
          Browse the shelf ↓
        </a>
      </div>
      <div class="book-installation" aria-hidden="true">
        <span>
          KEEP
          <br />
          AN OPEN
          <br />
          <em>MIND.</em>
        </span>
        <span>
          ONE MORE
          <br />
          <em>page.</em>
        </span>
        <span>
          BETWEEN
          <br />
          THE
          <br />
          <em>LINES</em>
        </span>
      </div>
    </div>
  </section>
  <PageParagraphs paragraphs={page.paragraphs} />
  <section class="wrap space" id="bookshelf">
    <div class="section-heading">
      <div>
        <span class="eyebrow">MY BOOKSHELF</span>
        <h2>Different books. New perspectives.</h2>
      </div>
    </div>
    <FilterPanel>
      <div
        class="book-journal-tools"
        role="group"
        aria-label="Filter the bookshelf"
      >
        <div>
          <label for="book-genre-filter">Explore a genre</label>
          <select id="book-genre-filter" aria-controls="book-results">
            <option value="All genres">All genres · {books.length}</option>
            {genres.map((genre) => (
              <option value={genre}>
                {genre} ·{" "}
                {books.filter((book) => book.genres.includes(genre)).length}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="book-rating-filter">My rating</label>
          <select id="book-rating-filter" aria-controls="book-results">
            <option value="all">All ratings</option>
            {[5, 4, 3, 2, 1, 0]
              .filter((rating) =>
                books.some((book) => (book.goodreads?.rating ?? 0) === rating),
              )
              .map((rating) => (
                <option value={rating}>
                  {rating ? `${rating} stars` : "Not rated"}
                </option>
              ))}
          </select>
        </div>
      </div>
    </FilterPanel>
    <p id="shelf-count" class="result-count" aria-live="polite">
      {books.length} books
    </p>
    <div class="books-grid" id="book-results">
      {books.map((book, index) => (
        <article
          class="book-card"
          data-book
          data-genres={JSON.stringify(book.genres)}
          data-rating={book.goodreads?.rating ?? "unrated"}
          data-book-search={`${book.title} ${book.author}`}
          id={
            book.goodreads ? `book-${book.goodreads.sourceReviewId}` : undefined
          }
        >
          {book.slug ? (
            <a
              class="book-jacket-link"
              href={`/books/${book.slug}`}
              aria-label={`Open ${book.title}`}
            >
              <BookJacket book={book} index={index} />
            </a>
          ) : (
            <BookJacket book={book} index={index} />
          )}
          <div class="book-caption">
            <span class="status-label">{book.genres.join(" · ")}</span>
            {book.goodreads && <BookRating rating={book.goodreads.rating} />}
            {book.slug && (
              <a class="book-journal-link" href={`/books/${book.slug}`}>
                {book.goodreads?.review ? "Read my notes" : "Open journal"}{" "}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
    <p id="book-empty" class="book-empty" hidden>
      No books match. Try another genre or rating.
    </p>
    <p class="editorial-caption">
      {completedBooks.length} completed books from my Goodreads shelf, with my
      own ratings and original notes. These typographic jackets are my shelf
      labels, not the publishers’ covers.
    </p>
  </section>
  <section class="library-band tone-sage">
    <div class="wrap">
      <span class="eyebrow">A PROJECT FOR BOOK PEOPLE</span>
      <h2>Meet Manahsmriti Books.</h2>
      <p>
        I also built a place to browse a shared catalog and keep a personal
        library.
      </p>
      <a class="text-link" href="https://manahsmriti-books.web.app">
        Visit the library ↗
      </a>
    </div>
  </section>
</Base>
