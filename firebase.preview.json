{
  "hosting": {
    "public": "dist/client",
    "ignore": ["firebase*.json", "**/.*", "**/node_modules/**", "**/archives/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Robots-Tag", "value": "noindex,nofollow" }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/{images,brand}/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }]
      }
    ],
    "rewrites": [
      {
        "regex": "^/(([a-vx-z0-9][a-z0-9]*|w([a-oq-z0-9][a-z0-9]*)?|wp[a-z0-9]+)(-[a-z0-9]+)*|(books|projects|entertainment|gogs)/[a-z0-9-]+|podcasts/(created|listening)(/[a-z0-9-]+)?|people-and-journal/(journal|people)(/[a-z0-9-]+)?|admin/(api|invitations)|api/(cms|v1|reading|search)(/[A-Za-z0-9_-]+)*(\\.(webp|mp4|webm|mp3|m4a|ogg))?|media/[a-f0-9]{64}/(master\\.webp|400\\.webp|800\\.webp|1600\\.webp|source\\.(mp4|webm|mp3|m4a|ogg))|api/openapi\\.json|sitemap\\.xml|rss\\.xml|_image)?/?$",
        "run": {
          "serviceId": "harithsa-journal-preview",
          "region": "us-east1",
          "pinTag": true
        }
      }
    ]
  }
}
